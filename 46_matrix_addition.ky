## Program 46: Matrix Addition (two 2x2 matrices) ##
auto a = [[1, 2], [3, 4]];
auto b = [[5, 6], [7, 8]];

auto result = [[0, 0], [0, 0]];
inte i = 0;
while (i < 2) {
    inte j = 0;
    while (j < 2) {
        result[i][j] = a[i][j] + b[i][j];
        j = j + 1;
    }
    i = i + 1;
}

show("Matrix A:", a);
show("Matrix B:", b);
show("A + B  :", result);
