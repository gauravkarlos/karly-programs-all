## 92. Check string palindrome ##
chr text = input("Enter a string: ");
chr reversed_text = "";
inte i = len(text) - 1;
while (i >= 0) {
    reversed_text = reversed_text + text[i];
    i = i - 1;
}
if (text == reversed_text) {
    show("'" + text + "' is a Palindrome");
} el {
    show("'" + text + "' is NOT a Palindrome");
}
