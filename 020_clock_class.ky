## 20. Create a Clock class to display time ##
class Clock {
    public:
    inte hours = 0;
    inte minutes = 0;
    fun __init__(inte h, inte m) { this.hours = h; this.minutes = m; }
    fun tick() {
        this.minutes = this.minutes + 1;
        if (this.minutes >= 60) {
            this.minutes = 0;
            this.hours = this.hours + 1;
        }
    }
    fun display() {
        show(this.hours, "hr", this.minutes, "min");
    }
}
auto clk = new Clock(9, 59);
clk.display();
clk.tick();
show("After one tick:");
clk.display();
