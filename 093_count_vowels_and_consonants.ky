## 93. Count vowels and consonants in a string ##
chr text = input("Enter a string: ");
inte vowel_count = 0;
inte consonant_count = 0;

foreach (ch in text) {
    boole is_letter = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z");
    if (is_letter) {
        if (ch == "a" || ch == "e" || ch == "i" || ch == "o" || ch == "u" ||
            ch == "A" || ch == "E" || ch == "I" || ch == "O" || ch == "U") {
            vowel_count = vowel_count + 1;
        } el {
            consonant_count = consonant_count + 1;
        }
    }
}

show("Vowels:", vowel_count);
show("Consonants:", consonant_count);
