## Program 43: Count Vowels in a String ##
chr text = input("Enter a string: ");
inte count = 0;
foreach (ch in text) {
    if (ch == "a" || ch == "e" || ch == "i" || ch == "o" || ch == "u" ||
        ch == "A" || ch == "E" || ch == "I" || ch == "O" || ch == "U") {
        count = count + 1;
    }
}
show("Vowel count:", count);
