## 29. Print prime numbers in a range ##
fun is_prime(inte n) -> boole {
    if (n < 2) {
        return false;
    }
    inte i = 2;
    while (i * i <= n) {
        if (n % i == 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

inte start_n = to_inte(input("Enter range start: "));
inte end_n = to_inte(input("Enter range end: "));

show("Prime numbers between", start_n, "and", end_n, ":");
inte n = start_n;
while (n <= end_n) {
    if (is_prime(n)) {
        show(n);
    }
    n = n + 1;
}
