## <DND_DESIGNER_GENERATED_CODE_START> -- generated by the D&D Builder; anything you type inside this block is preserved across re-syncs *except* control declarations themselves, which always reflect the designer -- write your own code outside the block. ##
include karlygui;

auto win = ui_app("Karly Greeting App", 360, 220);
auto root = ui_vbox(win);

auto vbox1 = ui_vbox(root);
auto label1 = ui_label(vbox1, "Enter your name:");
auto textinput1 = ui_textinput(vbox1, "");
auto button1 = ui_button(vbox1, "Say Hello", on_button1_on_press);
auto label2 = ui_label(vbox1, "");

fun on_button1_on_press() {
    chr entered_name = ui_get_text(textinput1);
    if (len(entered_name) == 0):
        ui_set_text(label2, "Please type your name first!");
    el:
        ui_set_text(label2, "Hello, " + entered_name + "!");
}

ui_run(win);
## <DND_DESIGNER_GENERATED_CODE_END> ##
