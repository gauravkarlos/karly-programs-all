## Program 36: Count Even/Odd Numbers in an Array ##
auto numbers = [12, 7, 5, 20, 33, 8, 15];
inte even_count = 0;
inte odd_count = 0;
inte i = 0;
while (i < len(numbers)) {
    if (numbers[i] % 2 == 0) {
        even_count = even_count + 1;
    } el {
        odd_count = odd_count + 1;
    }
    i = i + 1;
}
show("Array:", numbers);
show("Even count:", even_count);
show("Odd count:", odd_count);
