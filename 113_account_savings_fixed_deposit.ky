## 113. Create an Account base class with SavingsAccount and FixedDeposit derived classes ##
class Account {
    public:
    dou balance = 0.0;
    fun __init__(dou b) { this.balance = b; }
}
class SavingsAccount extends Account {
    public:
    fun apply_interest(dou rate) {
        this.balance = this.balance + (this.balance * rate / 100.0);
    }
}
class FixedDeposit extends Account {
    public:
    inte lock_years = 0;
    fun __init__(dou b, inte years) {
        this.balance = b;
        this.lock_years = years;
    }
    fun mature(dou rate) {
        inte i = 0;
        while (i < this.lock_years) {
            this.balance = this.balance + (this.balance * rate / 100.0);
            i = i + 1;
        }
    }
}
auto sa = new SavingsAccount(5000.0);
sa.apply_interest(4.0);
show("Savings after interest:", sa.balance);

auto fd = new FixedDeposit(5000.0, 3);
fd.mature(6.0);
show("Fixed deposit after maturity:", fd.balance);
