## 56. Create a password class with private password data (genuinely enforced with priblock -- see program 46's note on why plain private: would not actually block access here) ##
class Credentials {
    priblock:
        chr password;
    public:
    fun __init__(chr pw) {
        this.password = pw;
    }
    fun check(chr attempt) -> boole {
        return attempt == this.password;
    }
}
auto cred = new Credentials("karly123");
show("Correct password check:", cred.check("karly123"));
show("Wrong password check:", cred.check("guess"));
try {
    show(cred.password);
} catch (e) {
    show("Direct access genuinely blocked:", e);
}
