## Program 48: Star Pyramid Pattern ##
inte n = to_inte(input("Enter number of rows: "));
inte i = 1;
while (i <= n) {
    chr spaces = "";
    inte s = 0;
    while (s < n - i) {
        spaces = spaces + " ";
        s = s + 1;
    }
    chr stars = "";
    inte st = 0;
    while (st < (2 * i - 1)) {
        stars = stars + "*";
        st = st + 1;
    }
    show(spaces + stars);
    i = i + 1;
}
