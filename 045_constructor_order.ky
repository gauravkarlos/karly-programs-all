## 45. Demonstrate the order of constructor and cleanup execution. Since a class extending a base class does NOT automatically call the base's __init__ (verified below), the derived class's own __init__ must call it explicitly to get base-then-derived ordering. ##
class Base {
    public:
    fun __init__() {
        show("1. Base constructor runs");
    }
    fun base_setup() {
        show("(explicitly called) Base setup");
    }
}
class Derived extends Base {
    public:
    fun __init__() {
        this.base_setup();
        show("2. Derived constructor runs");
    }
}
auto d = new Derived();
